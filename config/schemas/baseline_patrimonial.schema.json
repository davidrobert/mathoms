{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline Patrimonial E1.5",
  "description": "Schema para o baseline_patrimonial-1.5_consolidated.json. Aceita formato original (v1) e formato E1.5 v2 (key aliases). A normalização em E4 converte v2 → v1 canonical antes da validação.",
  "type": "object",
  "required": ["pipeline_stage", "data_processamento"],
  "properties": {
    "pipeline_stage": {
      "type": "string",
      "const": "E1.5_Baseline_Patrimonial"
    },
    "data_processamento": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "membros": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["nome"],
            "properties": {
              "nome": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    },
    "anos_base": {
      "type": "array",
      "items": {"type": "integer", "minimum": 2020, "maximum": 2030}
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["membro", "ano_base", "bens_direitos"],
        "properties": {
          "membro": {"type": "string", "minLength": 1},
          "cpf": {"type": "string"},
          "ano_base": {"type": "integer"},
          "tipo_declaracao": {"type": "string"},
          "bens_direitos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["grupo", "descricao"],
              "properties": {
                "grupo": {"type": ["string", "integer"]},
                "codigo": {"type": ["string", "integer"]},
                "descricao": {"type": "string"},
                "valor_31_12_anterior": {"type": "number"},
                "valor_31_12_atual": {"type": "number"}
              }
            }
          },
          "total_bens": {"type": "number", "minimum": 0}
        }
      }
    },
    "patrimonio_por_ano": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "total_bens": {"type": "number"},
          "total_dividas": {"type": "number"}
        }
      }
    },
    "investimentos_consolidados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {"type": "string"},
          "tipo": {"type": "string"},
          "proprietario": {"type": "string"},
          "valores_31_12": {"type": "object"},
          "instituicao": {"type": "string"},
          "proprietarios": {
            "type": "array",
            "items": {"type": "string"},
            "description": "União de declarantes quando investimento é co-declarado (conta conjunta, ADR-271). Ausente → default [proprietario]. Singular preservado p/ compat downstream."
          },
          "investment_id": {
            "type": ["string", "null"],
            "description": "Hash estável de (tipo|instituicao|descricao_norm). Identidade de dedup cross-IRPF (ADR-271), não FK."
          },
          "_dedup_warning": {
            "type": "object",
            "properties": {
              "type": {"type": "string", "enum": ["valor_divergente_ano", "possivel_duplicata"]}
            },
            "description": "Divergência de valor no mesmo ano (cross-year) ou possível duplicata co-declarada com valores diferentes (ADR-271)."
          }
        }
      }
    },
    "imoveis_consolidados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {"type": "string"},
          "proprietario": {"type": "string"},
          "proprietarios": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Co-titulares quando imóvel é declarado em IRPFs de titular + cônjuge (ADR-246). Quando ausente, default é [proprietario]. Singular preservado p/ compat downstream."
          },
          "endereco": {"type": "string"},
          "tipo": {"type": "string"},
          "valores_31_12": {"type": "object"},
          "property_id": {"type": ["string", "null"]},
          "endereco_canonical": {"type": ["string", "null"]},
          "codigo_rfb": {"type": "string"},
          "_dedup_warning": {
            "type": "object",
            "description": "Marca divergência >10% de valores entre IRPFs co-declarados (ADR-246)."
          }
        }
      }
    },
    "veiculos_consolidados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {"type": "string"},
          "proprietario": {"type": "string"},
          "tipo": {"type": "string"},
          "valores_31_12": {"type": "object"},
          "veiculo_id": {
            "type": ["string", "null"],
            "description": "FK opcional para vehicles.id após reconciliação E1.5c (ADR-239)"
          }
        }
      }
    },
    "dividas": {
      "type": "array"
    },
    "receipts": {
      "type": "array"
    },
    "properties": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "description": "Format A: Consolidated (patrimonio_por_ano + listas consolidadas)",
      "required": ["patrimonio_por_ano"]
    },
    {
      "description": "Format B: Declarations (bens_direitos por grupo IRPF)",
      "required": ["declarations"]
    }
  ]
}
