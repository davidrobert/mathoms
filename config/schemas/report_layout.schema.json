{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fin.family/schemas/report_layout.schema.json",
  "title": "Report Layout",
  "description": "Schema do config/report_layout.yaml — fonte de verdade da estrutura do relatório (seções, cards, charts). Validado em pre-commit e CI (ADR-076).",
  "type": "object",
  "required": ["version", "estrategico"],
  "additionalProperties": true,

  "$defs": {
    "cardVariant": {
      "type": "string",
      "enum": [
        "highlight",
        "feature",
        "success",
        "warn",
        "critical",
        "primary",
        "neutral",
        "info",
        "top-danger",
        "top-accent"
      ],
      "description": "Deve existir como chave em design-tokens/tokens.json sob card_variants."
    },
    "cardSize": {
      "type": "string",
      "enum": ["full", "half"]
    },
    "topBorder": {
      "type": "string",
      "enum": ["danger", "accent"],
      "description": "ADR-117 · Fase 5 — borda superior decorativa. Renderiza .card-top-danger/.card-top-accent."
    },
    "heightSpec": {
      "oneOf": [
        {"type": "integer", "minimum": 100, "maximum": 800},
        {"type": "string", "enum": ["auto"]}
      ],
      "description": "ADR-117 · Fase 5 — altura em px ou 'auto' (ChartCanvas default)."
    },
    "cardSpec": {
      "type": "object",
      "required": ["id", "enabled"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+$"},
        "enabled": {"type": "boolean"},
        "variant": {"$ref": "#/$defs/cardVariant"},
        "size": {"$ref": "#/$defs/cardSize"},
        "top_border": {"$ref": "#/$defs/topBorder"},
        "comparison_anchor_id": {
          "type": "string",
          "description": "ADR-117 · Fase 5 — ID no comparisons[] do snapshot E5 (ativa quando Fase 6.5 entregar SnapshotChangelogBuilder)."
        }
      }
    },
    "chartSpec": {
      "type": "object",
      "required": ["id", "enabled"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+$"},
        "enabled": {"type": "boolean"},
        "row": {"type": "string"},
        "conclusion": {
          "type": "boolean",
          "description": "ADR-117/122 · Fase 5 — se true, renderiza <ChartConclusion> lendo chart_conclusions[id]."
        },
        "context": {
          "type": "boolean",
          "description": "ADR-117 · Fase 5 — se true, renderiza <p class=\"chart-context\"> antes do canvas."
        },
        "period_toggle": {
          "type": "boolean",
          "description": "ADR-117 · Fase 5 — se true, expõe <PeriodToggle> acima do canvas (charts temporais)."
        },
        "height": {"$ref": "#/$defs/heightSpec"}
      }
    },
    "comparisonSpec": {
      "type": "object",
      "required": ["id", "enabled"],
      "additionalProperties": false,
      "description": "Report Premium UI v2.1 — placeholder de bloco <ComparisonBlock>. Permanece enabled:false até v2.D.1 entregar SnapshotChangelogBuilder, e v2.8 ativar render.",
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+$"},
        "enabled": {"type": "boolean"},
        "deferred_until": {
          "type": "string",
          "description": "Lane v2 que ativará este bloco (ex.: 'v2.D.1 SnapshotChangelogBuilder')."
        }
      }
    },
    "changelogSpec": {
      "type": "object",
      "required": ["id", "enabled"],
      "additionalProperties": false,
      "description": "Report Premium UI v2.1 — placeholder de <ChangelogList>. Permanece enabled:false até v2.D.1 entregar SnapshotChangelogBuilder, e v2.8 ativar render.",
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+$"},
        "enabled": {"type": "boolean"},
        "deferred_until": {
          "type": "string",
          "description": "Lane v2 que ativará este bloco (ex.: 'v2.D.1 SnapshotChangelogBuilder')."
        }
      }
    },
    "sectionSpec": {
      "type": "object",
      "required": ["id", "title", "enabled"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "charts": {
          "type": "array",
          "items": {"$ref": "#/$defs/chartSpec"}
        },
        "cards": {
          "type": "array",
          "items": {"$ref": "#/$defs/cardSpec"}
        },
        "comparisons": {
          "type": "array",
          "items": {"$ref": "#/$defs/comparisonSpec"},
          "description": "Report Premium UI v2.1 — placeholders de <ComparisonBlock> por seção (enabled:false até v2.8)."
        },
        "changelog": {
          "type": "array",
          "items": {"$ref": "#/$defs/changelogSpec"},
          "description": "Report Premium UI v2.1 — placeholders de <ChangelogList> por seção (enabled:false até v2.8)."
        },
        "data_source": {"type": "string"},
        "summary": {
          "type": "boolean",
          "description": "ADR-117/122 · Fase 5 — se true, renderiza <SectionSummary> no topo com section_summaries[id]."
        },
        "divider_before": {
          "type": "boolean",
          "description": "ADR-117 · Fase 5 — se true, renderiza <SectionDivider> antes da seção."
        },
        "collapsible": {
          "type": "boolean",
          "description": "ADR-117 · Fase 5 — se true, header vira <CollapsibleSectionHeader>."
        }
      }
    },
    "appendixSpec": {
      "type": "object",
      "required": ["id", "title", "enabled"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "optional": {
          "type": "boolean",
          "description": "ADR-167 (A8.4 PR3) — apêndice condicional: renderer omite a página inteira (seção + entrada no TOC) quando o componente retorna null. Numeração A/B/C/D/E permanece literal (não recomputada)."
        },
        "charts": {
          "type": "array",
          "items": {"$ref": "#/$defs/chartSpec"},
          "description": "ADR-117 · Fase 5 — apêndices podem ter charts (ex.: APP_C cenários)."
        },
        "cards": {
          "type": "array",
          "items": {"$ref": "#/$defs/cardSpec"},
          "description": "ADR-117 · Fase 5 — apêndices podem ter cards (APP_B-E expandidos)."
        }
      }
    },
    "coverMetaSpec": {
      "type": "object",
      "required": ["label_key"],
      "additionalProperties": false,
      "properties": {
        "label_key": {"type": "string", "minLength": 1},
        "value_key": {"type": "string", "description": "Chave no snapshot E5 (ex.: 'periodo_dados'). Null = computado pelo shell."},
        "conditional_on": {"type": "string", "description": "v2.F.3b — só renderiza o card quando este campo do ReportResponse estiver presente (ex.: 'workspace_family_surname')."}
      }
    },
    "coverSpec": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "badge": {"type": "string"},
        "title_key": {"type": "string", "description": "Chave no snapshot para título; null = usa displayTitle do shell."},
        "subtitle_key": {"type": "string"},
        "meta": {
          "type": "array",
          "maxItems": 4,
          "items": {"$ref": "#/$defs/coverMetaSpec"}
        }
      }
    },
    "navLinkSpec": {
      "type": "object",
      "required": ["section_id"],
      "additionalProperties": false,
      "properties": {
        "section_id": {"type": "string"},
        "num": {"type": "string", "description": "Override de numeração. Se omitido, codegen deriva do id."},
        "is_appendix": {"type": "boolean"}
      }
    },
    "navGroupSpec": {
      "type": "object",
      "required": ["links"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string"},
        "links": {"type": "array", "items": {"$ref": "#/$defs/navLinkSpec"}}
      }
    },
    "navigationSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estrategico": {"type": "array", "items": {"$ref": "#/$defs/navGroupSpec"}}
      }
    },
    "kpiSpec": {
      "type": "object",
      "required": ["id", "label", "enabled"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"}
      }
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  },

  "properties": {
    "version": {"type": "string"},

    "estrategico": {
      "type": "object",
      "required": ["sections"],
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "items": {"$ref": "#/$defs/sectionSpec"}
        },
        "appendices": {
          "type": "array",
          "items": {"$ref": "#/$defs/appendixSpec"}
        }
      }
    },

    "chart_palette": {
      "type": "array",
      "items": {"$ref": "#/$defs/hexColor"}
    },

    "chart_canvas_map": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9_]+$": {"type": "string"}
      },
      "additionalProperties": false
    },

    "chart_titles": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9_]+$": {"type": "string"}
      },
      "additionalProperties": false
    },

    "cover": {"$ref": "#/$defs/coverSpec"},

    "navigation": {"$ref": "#/$defs/navigationSpec"},

    "footer": {
      "type": "boolean",
      "description": "ADR-117 · Fase 5 — liga/desliga o <footer> do relatório."
    },

    "export_toolbar": {
      "type": "boolean",
      "description": "ADR-117 · Fase 5 — liga/desliga <ExportToolbar>."
    },

    "section_charts": {
      "type": "object"
    },

    "usa_section_charts": {
      "type": "object"
    },

    "dark_mode": {
      "type": "object",
      "description": "Legado: cores hardcoded para dark mode. Será superseded por design-tokens em F9."
    },

    "version_fallback": {"type": "string"}
  }
}
