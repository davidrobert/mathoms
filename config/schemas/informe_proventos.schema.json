{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "informe_proventos.schema.json",
  "title": "Informe de Proventos — Ações + FII + JCP",
  "description": "Sub-schema do informe anual de proventos (ADR-238 L4). Pareado com pipeline.llm.schemas.informe_proventos.InformeProventosPayload. Strict — additionalProperties: false. Wire de dinheiro: string decimal (ADR-090). Tratamento fiscal: dividendo isento PF, JCP exclusiva 15%, rend_fii isento, bonificação ajuste de custo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cnpj_emissor", "nome_emissor"],
  "properties": {
    "cnpj_emissor": { "type": "string", "pattern": "^\\d{14}$" },
    "nome_emissor": { "type": "string", "minLength": 2 },
    "proventos": {
      "type": "array",
      "items": { "$ref": "#/$defs/provento" },
      "default": []
    },
    "posicao_31_12": {
      "type": "array",
      "items": { "$ref": "#/$defs/posicaoCustodia" },
      "default": []
    },
    "notas": { "type": ["string", "null"] }
  },
  "$defs": {
    "decimalString": {
      "description": "Wire de dinheiro: string decimal (ADR-090). Float é proibido.",
      "oneOf": [
        { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
        { "type": "integer" }
      ]
    },
    "decimalStringOrNull": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
        { "type": "integer" }
      ]
    },
    "tickerB3": {
      "type": "string",
      "pattern": "^[A-Z0-9]{4,10}$"
    },
    "provento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "cnpj_pagador", "tipo", "valor_brl", "data_pagamento"],
      "properties": {
        "ticker": { "$ref": "#/$defs/tickerB3" },
        "cnpj_pagador": { "type": "string", "pattern": "^\\d{14}$" },
        "cnpj_fonte": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^\\d{14}$" }
          ]
        },
        "tipo": {
          "type": "string",
          "enum": ["dividendo", "jcp", "rend_fii", "bonificacao"]
        },
        "valor_brl": { "$ref": "#/$defs/decimalString" },
        "data_pagamento": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "ir_retido_brl": { "$ref": "#/$defs/decimalString" },
        "notas": { "type": ["string", "null"] }
      }
    },
    "posicaoCustodia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "quantidade"],
      "properties": {
        "ticker": { "$ref": "#/$defs/tickerB3" },
        "quantidade": { "$ref": "#/$defs/decimalString" },
        "custo_medio_brl": { "$ref": "#/$defs/decimalStringOrNull" },
        "valor_mercado_31_12": { "$ref": "#/$defs/decimalStringOrNull" }
      }
    }
  }
}
