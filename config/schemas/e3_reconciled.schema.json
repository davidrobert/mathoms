{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E3 Reconciled",
  "description": "Saída de reconcile_account (*-3_reconciled.json). Campos obrigatórios alinhados a scripts/reconcile_transactions.py; transações preservam chaves extras dos bancos.",
  "type": "object",
  "required": [
    "banco",
    "tipo_conta",
    "moeda",
    "periodo_cobertura",
    "saldo_inicial",
    "saldo_inicial_unknown",
    "saldo_final",
    "saldo_final_unknown",
    "fontes",
    "transacoes_total",
    "transacoes_duplicadas_removidas",
    "transacoes"
  ],
  "properties": {
    "banco": {
      "type": "string",
      "minLength": 1
    },
    "tipo_conta": {
      "type": "string",
      "minLength": 1
    },
    "titular": {
      "type": ["string", "null"],
      "description": "DEPRECATED (ADR-226 PR2) — use `titulares`. Mantido por compat."
    },
    "titulares": {
      "type": "array",
      "items": {"type": "string"},
      "description": "ADR-226 PR2 — lista de titulares; conta conjunta tem 2+."
    },
    "account_number": {
      "type": ["string", "null"],
      "description": "ADR-226 PR2 — account_number normalizado (digits-only) do extrato."
    },
    "moeda": {
      "type": "string",
      "minLength": 1
    },
    "periodo_cobertura": {
      "type": "object",
      "required": ["inicio", "fim"],
      "properties": {
        "inicio": {
          "type": "string",
          "minLength": 1
        },
        "fim": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "saldo_inicial": {
      "type": "number"
    },
    "saldo_inicial_unknown": {
      "type": "boolean"
    },
    "saldo_final": {
      "type": "number"
    },
    "saldo_final_unknown": {
      "type": "boolean"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transacoes_total": {
      "type": "integer",
      "minimum": 0
    },
    "transacoes_duplicadas_removidas": {
      "type": "integer",
      "minimum": 0
    },
    "transacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "tx_carregadas": {
      "type": "integer",
      "minimum": 0,
      "description": "ADR-347 — âncora de contagem (pós-period-norm, PRÉ-anachronic/undated). Aditivo-opcional (PR1); required no flip HARD (PR3)."
    },
    "remocoes": {
      "type": "object",
      "description": "ADR-347 — partição de remoções de tx por canal (ledger de conservação de contagem). Aditivo-opcional (PR1). Fecha tx_carregadas == transacoes_total + Σ remocoes[*].count.",
      "properties": {
        "undated_drop": {"$ref": "#/$defs/remocao"},
        "anachronic": {"$ref": "#/$defs/remocao"},
        "intra_statement_dedup": {"$ref": "#/$defs/remocao"},
        "cross_file_dedup": {"$ref": "#/$defs/remocao"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "remocao": {
      "type": "object",
      "required": ["count", "valor_cents"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "valor_cents": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
