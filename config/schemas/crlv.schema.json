{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crlv.schema.json",
  "title": "CRLV-e (Comprovante de Bem · Veículo)",
  "description": "Schema do artefato extract_comprovantes_bens.crlv produzido pelo extractor LLM Haiku (ADR-239 D1). Pareado com pipeline.llm.schemas.crlv.CRLVPayload. Strict — additionalProperties: false. Sem valores monetários (placeholder FIPE preenchido em A18 L3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "placa",
    "renavam",
    "marca",
    "modelo",
    "ano_modelo",
    "ano_fabricacao",
    "exercicio",
    "categoria",
    "confidence",
    "prompt_version"
  ],
  "properties": {
    "placa": {
      "type": "string",
      "pattern": "^[A-Z]{3}\\d[A-Z\\d]\\d{2}$",
      "description": "Placa normalizada (sem hífen, upper)."
    },
    "renavam": {
      "type": "string",
      "pattern": "^[0-9]{9,11}$"
    },
    "marca": { "type": "string", "minLength": 2, "maxLength": 60 },
    "modelo": { "type": "string", "minLength": 1, "maxLength": 120 },
    "ano_modelo": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "ano_fabricacao": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "cor": { "type": ["string", "null"], "maxLength": 30 },
    "combustivel": { "type": ["string", "null"], "maxLength": 20 },
    "exercicio": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "categoria": { "type": "string", "minLength": 2, "maxLength": 40 },
    "proprietario_cpf_masked": {
      "type": ["string", "null"],
      "pattern": "^[\\d\\*]{3}\\.[\\d\\*]{3}\\.[\\d\\*]{3}-[\\d\\*]{2}$",
      "description": "CPF masked parcial (LGPD ADR-231). CPF completo nunca persiste."
    },
    "proprietario_nome": { "type": ["string", "null"], "maxLength": 120 },
    "municipio_emplacamento": { "type": ["string", "null"], "maxLength": 80 },
    "uf_emplacamento": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$"
    },
    "data_emissao": {
      "type": ["string", "null"],
      "format": "date",
      "description": "ISO 8601 (YYYY-MM-DD). None se ausente."
    },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "needs_review": { "type": "boolean", "default": false },
    "prompt_version": { "type": "string", "minLength": 1 },
    "notas": { "type": ["string", "null"], "maxLength": 500 }
  }
}
