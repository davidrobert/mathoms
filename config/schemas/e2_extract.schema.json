{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E2 Extract",
  "description": "Schema mínimo para artefatos E2 (extratos e faturas extraídos). Valida presença de campos obrigatórios sem restringir campos adicionais.",
  "type": "object",
  "required": ["banco", "tipo", "moeda"],
  "properties": {
    "pipeline_stage": {
      "type": "string",
      "minLength": 1
    },
    "banco": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "type": "string",
      "minLength": 1
    },
    "moeda": {
      "type": "string",
      "enum": ["BRL", "USD", "EUR"]
    },
    "transacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "ADR-283/ADR-284 — contrato fechado da transação E2. Campos enumerados a partir do audit dos parsers em scripts/e2/banks/ + writer LLM (_output_to_e2_json) + enriquecimento (direction/natural_key/amount). additionalProperties:false gera sinal de drift em modo warn sem abortar o run; ao adicionar campo novo a um writer, declare-o aqui (gate: tests/test_e2_schema_strict_corpus.py).",
        "required": ["data", "descricao", "valor"],
        "properties": {
          "data": {"type": "string"},
          "descricao": {"type": "string"},
          "valor": {"type": "number"},
          "amount": {"type": ["string", "null"]},
          "direction": {"type": ["string", "null"], "enum": ["debit", "credit", null]},
          "tipo_lancamento": {"type": ["string", "null"]},
          "tipo": {"type": ["string", "null"]},
          "categoria_sugerida": {"type": ["string", "null"]},
          "saldo_apos": {"type": ["number", "null"]},
          "parcela": {"type": ["string", "null"]},
          "nr_doc": {"type": ["string", "null"]},
          "cartao": {"type": ["string", "null"]},
          "forex": {
            "type": ["object", "null"],
            "required": ["moeda_original", "valor_original"],
            "properties": {
              "moeda_original": {"type": "string"},
              "valor_original": {"type": "number"},
              "cotacao": {"type": ["number", "null"]}
            },
            "additionalProperties": true
          },
          "natural_key": {
            "type": ["object", "null"],
            "required": ["hash", "hash_version"],
            "properties": {
              "hash": {"type": "string", "minLength": 1},
              "hash_version": {"type": "integer", "enum": [1, 2]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "periodo_inicio": {"type": "string"},
    "periodo_fim": {"type": "string"},
    "agencia": {"type": ["string", "null"]},
    "tipo_conta": {
      "type": ["string", "null"],
      "enum": ["corrente", "poupanca", "pj", "investimento", null]
    },
    "documento_titular": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
