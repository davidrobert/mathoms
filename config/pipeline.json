{
  "_comment": "Parâmetros operacionais do pipeline: LLM, limites de arquivo, reconciliação e regras de roteamento.",
  "_ultima_atualizacao": "2026-04-27",

  "report_version": "6.1",

  "schema_validation": {
    "enabled": true,
    "mode": "warn",
    "mode_overrides": {}
  },

  "llm": {
    "model": "claude-sonnet-4-20250514",
    "max_tokens": 500,
    "confidence_threshold": 0.7
  },

  "file_limits": {
    "preview_max_chars": 5000,
    "preview_max_rows": 20,
    "min_pdf_bytes": 1024,
    "min_xls_bytes": 40000,
    "min_csv_bytes": 500
  },

  "period_regex": {
    "period": "(\\d{6})(?:_(\\d{6}))?",
    "year_fallback": "(20\\d{2})"
  },

  "reconciliation": {
    "skip_types": [
      "investimentosposicao",
      "carteirarendafixa",
      "cdbdetalhes",
      "cdbresumo",
      "faturaaluguel",
      "informerendimentos",
      "irpf"
    ],
    "skip_files": [
      "baseline_patrimonial-1.5_consolidated.json",
      "dados_imoveis-2_extract.json"
    ],
    "tipo_canonical": {
      "extratoconta": "extratoconta",
      "extratocontapj": "extratocontapj",
      "extratocontapersonnalite": "extratocontapersonnalite",
      "extratopoupanca": "extratopoupanca",
      "extratocontaglobal": "extratocontaglobal",
      "extratocontaglobalusd": "extratocontaglobalusd",
      "extratocontaglobaleur": "extratocontaglobaleur",
      "faturacarbon": "faturacarbon",
      "faturaunique": "faturaunique",
      "faturapaoacucar": "faturapaoacucar"
    },
    "tolerances": {
      "saldo_diff": 0.01,
      "temporal_gap_days": 2,
      "baseline_irpf_diff": 1.0
    }
  },

  "qa_thresholds": {
    "_comment": "Tolerâncias para cross-validation no E7 e QA no E4.",
    "score_diff_max": 0.5,
    "patrimonio_composicao_diff_pct_max": 5,
    "cv_fluxo_diff_max": 100,
    "cv_taxa_poupanca_diff_pp_max": 5,
    "cv_if_monthly_diff_max": 500,
    "cv_if_progress_diff_pct_max": 2,
    "cv_endividamento_diff_pct_max": 1,
    "cv_reserva_cobertura_diff_max": 1,
    "qa_unidentified_target_pct": 10.0
  },

  "artifact_names": {
    "_comment": "Nomes de arquivos de artefatos do pipeline. Centraliza convenções de nomes.",
    "baseline_patrimonial": "baseline_patrimonial-1.5_consolidated.json",
    "receitas_unified": "receitas-4_unified.json",
    "despesas_unified": "despesas-4_unified.json",
    "investimentos_unified": "investimentos-4_unified.json",
    "fluxo_unified": "fluxo_mensal_detalhado-4_unified.json",
    "analise_e5": "analise_financeira-5_analysis.json"
  },

  "e2_llm": {
    "_comment": "E2-llm: uma chamada LLM por arquivo; concurrency reduz tempo total (ajuste se a API limitar). MATHOMS_E2_LLM_CONCURRENCY (1–8) sobrescreve só concurrency.",
    "concurrency": 4,
    "max_input_chars": 40000,
    "max_pdf_pages": 35
  },

  "log_files": {
    "_comment": "Logs operacionais regenerados pelo pipeline.",
    "operational": [
      "run_log.md",
      "reconciliation.md",
      "divergences.md",
      "e3_e4_execution_report.md",
      "quick_reference.txt"
    ],
    "preserved": [
      "inbox_log.md",
      "qa_log.md"
    ]
  }
}
