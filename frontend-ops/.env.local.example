# Console interno — variáveis de ambiente locais (F7F-Local · ADR-116).
# Copie para .env.local (gitignored) antes do primeiro `npm run dev`.

# Base do backend FastAPI (bind 127.0.0.1:8000 em dev).
# Usado só pelo Next rewrites() server-side — browser SEMPRE fala com /admin/*.
INTERNAL_OPS_API_BASE=http://127.0.0.1:8000
