# =============================================================================
# Mathoms AI — variáveis de ambiente (produção / dev-remoto · lane 7A-dev)
# =============================================================================
# Template para ambiente containerizado (Coolify + Docker compose) em
# `dev.mathoms.ai` (Hetzner CX32). Hosts referenciam nomes de serviço Coolify
# (postgres, redis); URLs públicas usam o domínio canônico (ADR-108).
#
# Uso:
#   1. cp .env.prod.example .env.prod.local      (gitignored — nunca commitar)
#   2. ./dev/gen-secrets.sh >> .env.prod.local   (gera 3 secrets)
#   3. revisar e ajustar valores marcados <change-me>
#   4. importar `.env.prod.local` no Coolify (UI) ou anexar ao serviço
#
# Backend lê com pydantic-settings (env_prefix MATHOMS_). Frontend Next.js
# lê NEXT_PUBLIC_* em build-time (não usa prefixo MATHOMS_).
# =============================================================================

# --- Ambiente ---
MATHOMS_ENVIRONMENT=production
MATHOMS_DEBUG=false

# --- Auth / Crypto ---
# Fernet (32 bytes url-safe base64). Gere com: ./dev/gen-secrets.sh
# Perder ou trocar invalida dados encriptados (vault, BYOK).
MATHOMS_FERNET_KEY=<gerar com dev/gen-secrets.sh>

# JWT signing key (>= 64 hex chars recomendado). Gere com: ./dev/gen-secrets.sh
MATHOMS_SECRET_KEY=<gerar com dev/gen-secrets.sh>
MATHOMS_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MATHOMS_ALGORITHM=HS256

# --- Database (PostgreSQL via serviço Coolify) ---
# Nome do serviço Coolify: `postgres` (ajustar se diferente no compose).
POSTGRES_USER=mathoms
POSTGRES_DB=mathoms
POSTGRES_PASSWORD=<gerar com dev/gen-secrets.sh>
MATHOMS_DATABASE_URL=postgresql+asyncpg://mathoms:<POSTGRES_PASSWORD>@postgres:5432/mathoms

# --- Redis broker (Celery message queue + result backend) ---
# Instância com policy `noeviction` (jobs Celery não evictam sob pressão).
MATHOMS_REDIS_URL=redis://redis-broker:6379/0

# --- Redis cache (Pub/Sub + cache ephemeral) ---
# Instância separada com `allkeys-lru` — pode evictar; consumidores
# tratam miss como recompute. Vazio = mesma instância do broker (dev).
MATHOMS_REDIS_CACHE_URL=redis://redis-cache:6379/0

# --- HTTP / CORS ---
# JSON array. Frontend serve em https://dev.mathoms.ai (mesmo host que API
# via reverse proxy do Coolify), então self-origin basta.
MATHOMS_CORS_ORIGINS=["https://dev.mathoms.ai"]

# --- Storage (volume persistente do Coolify mountado em /app/storage) ---
MATHOMS_STORAGE_ROOT=/app/storage
MATHOMS_MAX_UPLOAD_SIZE_MB=50
MATHOMS_MAX_STORAGE_PER_WORKSPACE_MB=500
MATHOMS_MAX_UPLOAD_BATCH_SIZE=150

# --- Feature flags ---
# Lane dev: sem infra de email — usuário criado já vem ativo.
REQUIRE_EMAIL_VERIFICATION=false

# Console interno (ADR-116 / F7F-Local) — fica off em prod por default.
# Ligue apenas se entender as implicações (IA-0 não é multi-tenant).
MATHOMS_INTERNAL_OPS_UI_ENABLED=false
MATHOMS_INTERNAL_OPS_ACCEPT_PRODUCTION_RISK=false

# --- LLM (opcional — BYOK por usuário na UI é o caminho preferido) ---
# Se setado aqui, vira fallback global para classificação E0 e tarefas server-side.
# ANTHROPIC_API_KEY=<change-me-or-leave-blank>

# --- Pipeline (opcional) ---
# MATHOMS_E2_LLM_CONCURRENCY=2
# MATHOMS_USE_DB_ARTIFACTS=true   # default no código; só override para debug

# =============================================================================
# Frontend (Next.js) — variáveis em build-time
# =============================================================================
# URL pública da API. Frontend é client-side; precisa do host externo,
# não do nome de serviço interno do compose.
NEXT_PUBLIC_API_URL=https://dev.mathoms.ai/api/v1

# Status page pública (opcional — link no rodapé quando definido).
# NEXT_PUBLIC_MATHOMS_STATUS_PAGE_URL=https://status.mathoms.ai
