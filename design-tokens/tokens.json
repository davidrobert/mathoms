  "card_variants": {
    "highlight": {
      "border_left": "4px solid var(--brand-primary)",
      "background": "color-mix(in srgb, var(--brand-primary) 6%, var(--surface-card))"
    },
    "feature": {
      "border": "1px solid var(--surface-border)",
      "background": "var(--surface-card)"
    },
    "success": {
      "border_left": "4px solid var(--semantic-gain)",
      "background": "color-mix(in srgb, var(--semantic-gain) 6%, var(--surface-card))"
    },
    "warn": {
      "border_left": "4px solid var(--semantic-alert)",
      "background": "color-mix(in srgb, var(--semantic-alert) 8%, var(--surface-card))"
    },
    "critical": {
      "border_left": "4px solid var(--semantic-loss)",
      "background": "color-mix(in srgb, var(--semantic-loss) 6%, var(--surface-card))"
    },
    "primary": {
      "border_left": "4px solid var(--brand-primary)",
      "background": "var(--surface-card)"
    },
    "neutral": {
      "border_left": "4px solid var(--brand-neutral)",
      "background": "var(--surface-card)"
    },
    "top-danger": {
      "border_top": "4px solid var(--semantic-loss)",
      "background": "var(--surface-card)"
    },
    "top-accent": {
      "border_top": "4px solid var(--brand-accent)",
      "background": "var(--surface-card)"
    }
  }
