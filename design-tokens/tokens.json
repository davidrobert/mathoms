{
  "$schema": "./tokens.schema.json",
  "meta": {
    "version": "1.0.0",
    "name": "Ferreira Campos Editorial",
    "description": "Tokens unificados site × relatório (ADR-076)",
    "source_of_truth": "design-tokens/tokens.json",
    "updated": "2026-04-15"
  },

  "typography": {
    "fonts": {
      "display": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
      "body": "'Inter', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace"
    },
    "sizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "md": "1.125rem",
      "lg": "1.25rem",
      "xl": "1.5rem",
      "2xl": "1.875rem",
      "3xl": "2.25rem",
      "4xl": "3rem"
    },
    "line_heights": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.6"
    },
    "weights": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800"
    }
  },

  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.25rem",
    "2xl": "1.5rem",
    "3xl": "2rem",
    "4xl": "2.5rem",
    "5xl": "3rem",
    "6xl": "4rem"
  },

  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "card": "0.75rem",
    "pill": "9999px"
  },

  "shadow": {
    "sm": "0 1px 2px rgb(0 0 0 / 0.05)",
    "md": "0 1px 3px rgb(0 0 0 / 0.06), 0 1px 2px rgb(0 0 0 / 0.04)",
    "lg": "0 4px 12px rgb(0 0 0 / 0.08)",
    "card": "0 1px 3px rgb(0 0 0 / 0.06)",
    "card_hover": "0 4px 12px rgb(0 0 0 / 0.08)",
    "card_dark": "0 1px 6px rgb(0 0 0 / 0.25)",
    "card_hover_dark": "0 6px 18px rgb(0 0 0 / 0.35)"
  },

  "modes": {
    "light": {
      "brand": {
        "primary": "#1A3A5C",
        "primary_foreground": "#FFFFFF",
        "accent": "#15803D",
        "accent_foreground": "#FFFFFF",
        "danger": "#B91C1C",
        "danger_foreground": "#FFFFFF",
        "warning": "#F4A261",
        "warning_foreground": "#1A3A5C",
        "neutral": "#457B9D",
        "info": "#1E6E8F"
      },
      "surface": {
        "background": "#FFFFFF",
        "foreground": "#0F172A",
        "card": "#FFFFFF",
        "card_foreground": "#0F172A",
        "popover": "#FFFFFF",
        "popover_foreground": "#0F172A",
        "muted": "#F1F5F9",
        "muted_foreground": "#475569",
        "border": "#E2E8F0",
        "input": "#E2E8F0",
        "ring": "#94A3B8",
        "row_even": "#F8FAFC",
        "row_hover": "#EFF6FF"
      },
      "semantic": {
        "gain": "#15803D",
        "loss": "#B91C1C",
        "alert": "#F4A261",
        "neutral_financial": "#64748B",
        "info_financial": "#1E6E8F"
      },
      "chart": [
        "#1A3A5C", "#15803D", "#B91C1C", "#F4A261",
        "#6D28D9", "#0891B2", "#CA8A04", "#BE185D",
        "#166534", "#9F1239", "#0369A1", "#A16207"
      ],
      "sidebar": {
        "background": "#F8FAFC",
        "foreground": "#0F172A",
        "primary": "#1A3A5C",
        "primary_foreground": "#FFFFFF",
        "accent": "#F1F5F9",
        "accent_foreground": "#1A3A5C",
        "border": "#E2E8F0",
        "ring": "#94A3B8"
      }
    },
    "dark": {
      "brand": {
        "primary": "#7EB8DA",
        "primary_foreground": "#0F172A",
        "accent": "#4ADE80",
        "accent_foreground": "#052E16",
        "danger": "#FB7185",
        "danger_foreground": "#4C0519",
        "warning": "#FDBA74",
        "warning_foreground": "#1C1917",
        "neutral": "#94A3B8",
        "info": "#5CC8F0"
      },
      "surface": {
        "background": "#0F172A",
        "foreground": "#F8FAFC",
        "card": "#1E293B",
        "card_foreground": "#F8FAFC",
        "popover": "#1E293B",
        "popover_foreground": "#F8FAFC",
        "muted": "#1E293B",
        "muted_foreground": "#94A3B8",
        "border": "#334155",
        "input": "#334155",
        "ring": "#64748B",
        "row_even": "#1E293B",
        "row_hover": "#334155"
      },
      "semantic": {
        "gain": "#4ADE80",
        "loss": "#FB7185",
        "alert": "#FDBA74",
        "neutral_financial": "#94A3B8",
        "info_financial": "#5CC8F0"
      },
      "chart": [
        "#7EB8DA", "#4ADE80", "#FB7185", "#FDBA74",
        "#A78BFA", "#22D3EE", "#FACC15", "#F472B6",
        "#86EFAC", "#FCA5A5", "#7DD3FC", "#FBBF24"
      ],
      "sidebar": {
        "background": "#0F172A",
        "foreground": "#F8FAFC",
        "primary": "#7EB8DA",
        "primary_foreground": "#0F172A",
        "accent": "#1E293B",
        "accent_foreground": "#F8FAFC",
        "border": "#334155",
        "ring": "#64748B"
      }
    }
  },

  "card_variants": {
    "highlight": {
      "border_left": "4px solid var(--brand-primary)",
      "background": "color-mix(in srgb, var(--brand-primary) 6%, var(--surface-card))"
    },
    "feature": {
      "border": "1px solid var(--surface-border)",
      "background": "var(--surface-card)"
    },
    "success": {
      "border_left": "4px solid var(--semantic-gain)",
      "background": "color-mix(in srgb, var(--semantic-gain) 6%, var(--surface-card))"
    },
    "warn": {
      "border_left": "4px solid var(--semantic-alert)",
      "background": "color-mix(in srgb, var(--semantic-alert) 8%, var(--surface-card))"
    },
    "critical": {
      "border_left": "4px solid var(--semantic-loss)",
      "background": "color-mix(in srgb, var(--semantic-loss) 6%, var(--surface-card))"
    },
    "primary": {
      "border_left": "4px solid var(--brand-primary)",
      "background": "var(--surface-card)"
    },
    "neutral": {
      "border_left": "4px solid var(--brand-neutral)",
      "background": "var(--surface-card)"
    },
    "top-danger": {
      "border_top": "4px solid var(--semantic-loss)",
      "background": "var(--surface-card)"
    },
    "top-accent": {
      "border_top": "4px solid var(--brand-accent)",
      "background": "var(--surface-card)"
    }
  }
}
