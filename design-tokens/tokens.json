  "report_typography": {
    "_description": "Escala tipográfica do relatório — base 13px default (ADR-121). Escopada em [data-report-scope][data-font-scale=*]. Três presets selecionáveis pelo usuário, persistidos em localStorage['mathoms:report:font-scale'].",
    "default_scale": "compact",
    "scales": {
      "compact": {
        "base_px": 13,
        "xs": "10px",
        "sm": "12px",
        "base": "13px",
        "md": "14px",
        "lg": "16px",
        "xl": "22px",
        "2xl": "28px",
        "3xl": "38px"
      },
      "normal": {
        "base_px": 15,
        "xs": "11px",
        "sm": "13px",
        "base": "15px",
        "md": "16px",
        "lg": "18px",
        "xl": "24px",
        "2xl": "30px",
        "3xl": "42px"
      },
      "comfortable": {
        "base_px": 17,
        "xs": "13px",
        "sm": "15px",
        "base": "17px",
        "md": "18px",
        "lg": "20px",
        "xl": "26px",
        "2xl": "32px",
        "3xl": "46px"
      }
    },
    "spacing_scope": {
