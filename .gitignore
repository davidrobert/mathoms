# ============================================
# financas-familia — .gitignore
# ============================================

# Arquivos financeiros originais (PDFs, imagens)
# Imutáveis, grandes (~21MB), sensíveis.
# Mantidos localmente, não versionados.
data/
inbox/
inbox_processed/

# OS / Editor
.DS_Store
.obsidian/

# Senhas
config/passwords.txt

# Scratch — artefatos temporários de pipeline (scripts, relatórios, logs)
_scratch/

# Python
__pycache__/
*.pyc

# Testing
.pytest_cache/

# Virtual environment
.venv/

# Backups legados — substituídos pelo histórico Git
*.bak
*_backup.*
*_prev.*
*_pre_fix.*
