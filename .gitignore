# ============================================
# financas-familia — .gitignore
# ============================================

# Arquivos financeiros originais (PDFs, imagens)
# Imutáveis, grandes (~21MB), sensíveis.
# Mantidos localmente, não versionados.
data/
inbox/
inbox_processed/

# OS / Editor
.DS_Store
.obsidian/

# Senhas
config/passwords.txt

# Scratch — artefatos temporários de pipeline (scripts, relatórios, logs)
_scratch/

# Codex — estado local de agente, sessões, caches e worktrees.
# Exceção: o mirror de agentes é versionado e gerado a partir de .claude/agents/.
.codex/*
!.codex/agents/
!.codex/agents/*.toml

# Python
__pycache__/
*.pyc
*.egg-info/

# Database (dev)
*.db
*.db-shm
*.db-wal

# Per-tenant file storage (uploads, processed, reports)
storage/
# Exceção: subpacote de código services/storage/ (ADR-285) — sem âncora, o
# padrão acima engoliria o pacote e git add pularia arquivos silenciosamente
!backend/app/services/storage/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/coverage/
frontend/tsconfig.tsbuildinfo
frontend-ops/tsconfig.tsbuildinfo
frontend/.lighthouseci/
frontend/playwright-report/
frontend/playwright-results/
# Visual snapshots locais (macOS/non-Linux) não devem ser commitados —
# baselines são geradas exclusivamente em CI Linux (lane report-a11y-finalize).
frontend/tests/**/*-darwin.png
frontend/tests/**/*-win32.png
node_modules/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environment
.venv/
.venv-lint/

# Backups legados — substituídos pelo histórico Git
*.bak
*_backup.*
*_prev.*
*_pre_fix.*

# Secrets — aplicam em qualquer diretório (sem leading slash = basename match).
# `.env.example` e `.env.prod.example` continuam versionados (são templates).
.env
.env.test
.env.prod
.env.prod.local

# Smoke test — estado local efêmero (A6b.5)
_smoke_pids/
_smoke_storage/
mathoms-smoke.db

# Dev stack (make dev-up) — PIDs e logs de processos locais
_dev_pids/

# Override local do compose dev (A20.L6) — vars/secrets locais; só o
# `.example` é versionado.
docker-compose.dev.override.yml

# F7F-Local console interno (ADR-116) — credenciais de operadores nunca
# vão pro git. Apenas o template `.example` é commitado.
config/internal_operators.yaml
logs/internal_ops_audit.log
logs/
.venv-pr1/

# Worktrees de agente — cópias completas do repo (dezenas de MB cada), e
# qualquer coisa que o agente deixe cair na raiz delas. Estava só em
# `.git/info/exclude`, que é LOCAL e não viaja para outro clone: de dentro
# do worktree o padrão da raiz não se aplica e um `git add -A` ali dentro
# estagiaria o que estivesse solto (medido 2026-07-31 com um mirror bare de
# 39 MB contendo o histórico inteiro). Aqui a regra é versionada.
.claude/worktrees/

# Resíduo de ferramenta e diretórios de trabalho que nunca são versionados.
# `_archive/` e `processed/` já são bloqueados por dev/check_forbidden_paths.py
# ([[ADR-319]]), mas hook é cinto — o .gitignore é o suspensório, e sobrevive
# a `--no-verify`. `_archive/` reapareceu em 2026-07-31 (config do Obsidian,
# sem PII) provando que o path volta sozinho.
_archive/
archive/
processed/
output/
.hypothesis/

# Mirrors bare criados para backup pré-flip (PLAN-public-release W0/A34.l2).
# A lane exige guardá-los FORA da árvore do repo; este padrão é a rede caso
# um caia aqui dentro — carregam o histórico completo, PII inclusa.
*-mirror.git/
mathoms-pre-public-flip.git/
