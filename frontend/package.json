  "main": "index.js",
  "scripts": {
    "design-tokens:build": "cd .. && python3 design-tokens/build.py",
    "design-tokens:check": "cd .. && python3 design-tokens/build.py --check",
    "report-layout:build": "cd .. && python3 dev/codegen_report_layout.py",
    "report-layout:check": "cd .. && python3 dev/codegen_report_layout.py --check",
    "codegen:all": "npm run design-tokens:build && npm run report-layout:build",
    "codegen:check": "npm run design-tokens:check && npm run report-layout:check",
    "predev": "npm run codegen:check",
    "prebuild": "npm run codegen:all",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install"
  },
  "keywords": [],
