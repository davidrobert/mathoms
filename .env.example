# =============================================================================
# Fin — variáveis de ambiente (exemplo)
# =============================================================================
# Copie para a raiz do repositório e ajuste:
#   cp .env.example .env
# Gere chaves obrigatórias (Fernet + JWT):
#   ./scripts/gen-secrets.sh --init-env
# Ou só imprimir pares para colar manualmente:
#   ./scripts/gen-secrets.sh
#
# O backend carrega este arquivo automaticamente (pydantic-settings, env_prefix FIN_).
# Nunca commite o arquivo .env (contém segredos).
# =============================================================================

# --- Obrigatório em qualquer ambiente que use vault / uploads ---
# Fernet (32 bytes url-safe base64). Perder ou trocar invalida dados encriptados.
# Gere com: ./scripts/gen-secrets.sh
FIN_FERNET_KEY=

# JWT / assinatura de tokens (use valor forte em produção).
FIN_SECRET_KEY=dev-secret-change-in-production

# --- Banco de dados ---
# Dev (SQLite async, caminho relativo ao cwd do processo uvicorn — rode a API da raiz ou use path absoluto).
FIN_DATABASE_URL=sqlite+aiosqlite:///./fin.db

# --- Redis (Celery + pub/sub) ---
FIN_REDIS_URL=redis://localhost:6379/0

# --- HTTP ---
# JSON array (aspas duplas internas escapadas ou string única conforme seu shell).
FIN_CORS_ORIGINS=["http://localhost:3000"]

# --- Armazenamento ---
FIN_STORAGE_ROOT=./storage

# Raiz do pipeline (config/, output/, etc.). Default no código: raiz do repositório.
# FIN_PIPELINE_ROOT=.

# --- Opcionais (defaults sensatos no código) ---
# FIN_DEBUG=true
# FIN_PROJECT_NAME=Fin API
# FIN_API_PREFIX=/api
# FIN_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# FIN_ALGORITHM=HS256
# FIN_MAX_UPLOAD_SIZE_MB=50
# FIN_MAX_STORAGE_PER_WORKSPACE_MB=500
# FIN_MAX_UPLOAD_BATCH_SIZE=20

# --- Alembic (apenas quando aplicável) ---
# Descomente só em testes do guard ou cenários especiais (ver backend/alembic/env.py).
# FIN_ALEMBIC_ALLOW_RELATIVE_SQLITE=1

# --- LLM (opcional — BYOK na UI ou aqui para CLI / classificador) ---
# ANTHROPIC_API_KEY=

# --- Pipeline (opcional) ---
# FIN_E2_LLM_CONCURRENCY=2

# --- Testes / E2E (não usar em produção) ---
# FIN_LLM_MOCK=1
