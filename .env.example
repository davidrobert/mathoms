# =============================================================================
# Mathoms AI — variáveis de ambiente (exemplo)
# =============================================================================
# Copie para a raiz do repositório e ajuste:
#   cp .env.example .env
# Gere chaves obrigatórias (Fernet + JWT):
#   ./scripts/gen-secrets.sh --init-env
# Ou só imprimir pares para colar manualmente:
#   ./scripts/gen-secrets.sh
#
# O backend carrega este arquivo automaticamente (pydantic-settings, env_prefix MATHOMS_).
# Nunca commite o arquivo .env (contém segredos).
# =============================================================================

# --- Obrigatório em qualquer ambiente que use vault / uploads ---
# Fernet (32 bytes url-safe base64). Perder ou trocar invalida dados encriptados.
# Gere com: ./scripts/gen-secrets.sh
MATHOMS_FERNET_KEY=

# JWT / assinatura de tokens (use valor forte em produção).
MATHOMS_SECRET_KEY=dev-secret-change-in-production

# --- Banco de dados ---
# Em dev, deixe comentado: o default em backend/app/core/config.py resolve
# para caminho absoluto (_PROJECT_ROOT / 'mathoms.db'). O guard F6.5E.4 do
# Alembic rejeita SQLite com path relativo (sqlite+aiosqlite:///./...) para
# evitar aplicar migrations na DB errada conforme o cwd. Para sobrescrever,
# use sempre path absoluto (4 barras): sqlite+aiosqlite:////caminho/abs/db.
# MATHOMS_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/mathoms.db

# --- Redis (Celery + pub/sub) ---
MATHOMS_REDIS_URL=redis://localhost:6379/0

# --- HTTP ---
# JSON array (aspas duplas internas escapadas ou string única conforme seu shell).
MATHOMS_CORS_ORIGINS=["http://localhost:3000"]

# --- Armazenamento ---
MATHOMS_STORAGE_ROOT=./storage

# Raiz do workspace para scripts/pipeline_common (config/, data/, inbox/, …).
# Obrigatório para `python scripts/e*.py` fora do app; `python -m pipeline.run_dev --root` define sozinha.
# API/worker/pytest fazem default para a raiz do repo em dev.
# MATHOMS_WORKSPACE_ROOT=/caminho/absoluto/para/repo-ou-tenant

# Raiz do pipeline (config/, output/, etc.). Default no código: raiz do repositório.
# MATHOMS_PIPELINE_ROOT=.

# --- Opcionais (defaults sensatos no código) ---
# MATHOMS_DEBUG=true
# MATHOMS_PROJECT_NAME=Mathoms AI
# MATHOMS_API_PREFIX=/api
# MATHOMS_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# MATHOMS_ALGORITHM=HS256
# MATHOMS_MAX_UPLOAD_SIZE_MB=50
# MATHOMS_MAX_STORAGE_PER_WORKSPACE_MB=500
# MATHOMS_MAX_UPLOAD_BATCH_SIZE=150

# --- Alembic (apenas quando aplicável) ---
# Descomente só em testes do guard ou cenários especiais (ver backend/alembic/env.py).
# MATHOMS_ALEMBIC_ALLOW_RELATIVE_SQLITE=1

# --- LLM (opcional — BYOK na UI ou aqui para CLI / classificador) ---
# ANTHROPIC_API_KEY=

# --- Pipeline (opcional) ---
# MATHOMS_E2_LLM_CONCURRENCY=2

# --- Testes / E2E (não usar em produção) ---
# MATHOMS_LLM_MOCK=1

# --- Console interno de operações (IA-0 · ADR-116; runbook §7) ---
# Rotas /admin/* só montam com a flag; secret DEVE ser distinto de MATHOMS_SECRET_KEY.
# MATHOMS_INTERNAL_OPS_UI_ENABLED=1
# MATHOMS_INTERNAL_OPS_SESSION_SECRET=
# INTERNAL_OPS_API_BASE=http://127.0.0.1:8001

# =============================================================================
# Frontend (Next.js) — criar frontend/.env.local (não usa prefixo MATHOMS_)
# =============================================================================
# Status page pública (7E.6): link "Status e incidentes" no rodapé quando definido.
# NEXT_PUBLIC_MATHOMS_STATUS_PAGE_URL=https://status.mathoms.ai
